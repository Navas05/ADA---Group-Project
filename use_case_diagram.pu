@startuml
left to right direction

' Global settings
skinparam shadowing false
skinparam packageStyle rectangle

' Use Case styling
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Actor styling
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}

' Note styling
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
}

' Arrow styling
skinparam arrow {
    Color #2B3E6A
}

'=== Actors ===
' Define your actors here (e.g., actor "Customer" as cust)
actor "Employee" as employee
actor "Administrator" as admin
actor "Super Administrator" as super
actor "External Notification System" as notification

'=== System Boundary ===
rectangle "Invoices Management App Environment" {

    '=== Use Cases ===
    ' Define your use cases here (e.g., usecase "Login" as UC1)
    usecase "Create Invoice" as UC1
    usecase "Modify Invoice" as UC2
    usecase "Cancel Invoice" as UC3
    usecase "Unsubscribe Clients" as UC4
    usecase "Access Financial Statistics" as UC5
    usecase "Manage Client Notifications" as UC6

    usecase "Modify Employee Access" as AC1

    usecase "Access Modification's History" as SC1

    usecase "Send Notification" as NC1
    
    usecase "Authorise Employee's Operations" as AuC1

    usecase "Manage Pending Tasks" as PT1
}

'=== Relationships ===
' Connect actors to use cases or use cases to each other here
employee -- PT1
employee -- UC4
employee -- UC5
employee -- UC6

admin -- AC1

super -- SC1

notification -- NC1

PT1 <.. UC1 : <<extend>>
PT1 <.. UC2 : <<extend>>
PT1 <.. UC3 : <<extend>>

PT1 ..> AuC1 : <<include>>
UC4 ..> AuC1 : <<include>>
UC5 ..> AuC1 : <<include>>
UC6 ..> AuC1 : <<include>>
AC1 ..> AuC1 : <<include>>
SC1 ..> AuC1 : <<include>>

UC1 ..> NC1 : <<include>>
UC2 ..> NC1 : <<include>>
UC3 ..> NC1 : <<include>>
UC4 ..> NC1 : <<include>>

employee <|-- admin
admin <|-- super

@enduml